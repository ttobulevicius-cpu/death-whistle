    </section>

    <!-- Checkout Section -->
    <section class="checkout-section" id="checkout">
      <div class="checkout-title">
        <h2>Secure Your Artifact</h2>
        <p style="color: var(--text-muted); margin-top: 6px;">Guaranteed safe & encrypted checkout</p>
      </div>

      <div class="checkout-grid">
        <!-- Customer Info Form -->
        <div class="checkout-card">
          <h3 style="margin-bottom: 20px; font-size: 1.25rem;">1. Shipping Address</h3>
          <form id="orderForm" onsubmit="handleOrder(event)">
            <div class="form-row">
              <div class="form-group">
