        <!-- Variants -->
        <div class="variant-section">
          <span class="variant-label">SELECT ARTIFACT FINISH: <strong id="selectedVariantName" style="color: #fff;">Ancient Bone</strong></span>
          <div class="variant-options">
            <button class="variant-btn active" data-name="Ancient Bone" data-img="https://img.kwcdn.com/product/fancy/1aca0b30-cde6-4da1-ac6c-f72760ec78dd.jpg">
              <span class="swatch swatch-bone"></span> Ancient Bone
            </button>
            <button class="variant-btn" data-name="Obsidian Void" data-img="https://img.kwcdn.com/product/fancy/1aca0b30-cde6-4da1-ac6c-f72760ec78dd.jpg">
              <span class="swatch swatch-obsidian"></span> Obsidian
            </button>
            <button class="variant-btn" data-name="Blood Ochre" data-img="https://img.kwcdn.com/product/fancy/1aca0b30-cde6-4da1-ac6c-f72760ec78dd.jpg">
