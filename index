  <!-- Success Modal -->
  <div class="success-modal" id="modal">
    <div class="success-box">
      <span style="font-size: 3rem;">💀</span>
      <h2 style="margin: 16px 0 8px; color: var(--gold-light);">ORDER CONFIRMED</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 24px;">
        Your Aztec Screaming Death Whistle is being prepared. Prepare your lungs and warn your neighbors.
      </p>
      <button class="nav-cta" style="border:none; cursor:pointer;" onclick="closeModal()">Close</button>
    </div>
  </div>

  <script>
    // Variant Selection Logic
    const variantButtons = document.querySelectorAll('.variant-btn');
    const selectedVariantText = document.getElementById('selectedVariantName');
    const summaryVariantText = document.getElementById('summaryVariant');

    variantButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        variantButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const name = btn.getAttribute('data-name');
        selectedVariantText.textContent = name;
        summaryVariantText.textContent = `Variant: ${name}`;
      });
    });

    // Sound Synthesizer (Realistic howling screech using Web Audio API)
    const soundBtn = document.getElementById('soundBtn');
    soundBtn.addEventListener('click', () => {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        const ctx = new AudioCtx();

        // White Noise buffer for the wind/shriek friction
        const bufferSize = ctx.sampleRate * 2.5; // 2.5 seconds
        const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          data[i] = Math.random() * 2 - 1;
        }

        const noise = ctx.createBufferSource();
        noise.buffer = buffer;

        // Bandpass filter to model acoustic whistle resonance
        const filter = ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(1400, ctx.currentTime);
        filter.frequency.linearRampToValueAtTime(3200, ctx.currentTime + 0.8);
        filter.frequency.linearRampToValueAtTime(900, ctx.currentTime + 2.5);
        filter.Q.value = 6;

        // Gain envelope
        const gainNode = ctx.createGain();
        gainNode.gain.setValueAtTime(0.01, ctx.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.8, ctx.currentTime + 0.3);
        gainNode.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 2.5);

        noise.connect(filter);
        filter.connect(gainNode);
        gainNode.connect(ctx.destination);

        noise.start();
        soundBtn.textContent = '🔊 Shrieking...';
        setTimeout(() => {
          soundBtn.innerHTML = '<span>🔊</span> Hear It Scream';
        }, 2500);
      } catch(e) {
        alert("Audio playback not supported in this browser.");
      }
    });

    // Form Checkout Simulation
    function handleOrder(e) {
      e.preventDefault();
      document.getElementById('modal').style.display = 'flex';
    }

    function closeModal() {
      document.getElementById('modal').style.display = 'none';
      document.getElementById('orderForm').reset();
    }
  </script>
</body>
</html>
