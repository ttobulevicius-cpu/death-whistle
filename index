<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Aztec Death Whistle | Handcrafted Terrifying Replica</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg-dark: #0a0908;
      --bg-surface: #141210;
      --bg-card: #1c1917;
      --border: #2c2724;
      --accent: #dc2626;
      --accent-hover: #b91c1c;
      --gold: #d97706;
      --gold-light: #fbbf24;
      --text-main: #f5f5f4;
      --text-muted: #a8a29e;
      --radius: 12px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      overflow-x: hidden;
      line-height: 1.6;
    }

    h1, h2, h3, .brand-font {
      font-family: 'Cinzel', serif;
      letter-spacing: 0.05em;
    }

    /* Promo Ticker */
    .top-bar {
      background: linear-gradient(90deg, #991b1b, #dc2626, #991b1b);
      color: #fff;
      text-align: center;
      padding: 8px 16px;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    /* Navigation */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 8%;
      border-bottom: 1px solid var(--border);
      background: rgba(10, 9, 8, 0.85);
      backdrop-filter: blur(10px);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.25rem;
      font-weight: 900;
      color: var(--gold-light);
    }

    .nav-cta {
      background: var(--accent);
      color: white;
      text-decoration: none;
      padding: 10px 22px;
      border-radius: 30px;
      font-weight: 600;
      font-size: 0.9rem;
      transition: all 0.2s ease;
      box-shadow: 0 0 15px rgba(220, 38, 38, 0.4);
    }

    .nav-cta:hover {
      background: var(--accent-hover);
      transform: translateY(-1px);
    }

    /* Container */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Hero Section */
    .hero {
      padding: 60px 0 80px;
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 50px;
      align-items: center;
    }

    .gallery-container {
      position: relative;
    }

    .main-image-box {
      width: 100%;
      height: 480px;
      border-radius: var(--radius);
      overflow: hidden;
      border: 1px solid var(--border);
      background: radial-gradient(circle at center, #2e2621 0%, #141210 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .product-img {
      max-width: 85%;
      max-height: 85%;
      object-fit: contain;
      filter: drop-shadow(0 20px 30px rgba(0,0,0,0.8));
      transition: transform 0.4s ease;
    }

    .main-image-box:hover .product-img {
      transform: scale(1.04) rotate(-2deg);
    }

    .badge-loud {
      position: absolute;
      top: 16px;
      left: 16px;
      background: rgba(0,0,0,0.7);
      backdrop-filter: blur(8px);
      border: 1px solid var(--accent);
      color: #fca5a5;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 700;
    }

    /* Audio Demo Button */
    .audio-tester {
      margin-top: 16px;
      padding: 16px;
      border-radius: var(--radius);
      background: var(--bg-surface);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .play-scream-btn {
      background: #27211e;
      border: 1px solid var(--gold);
      color: var(--gold-light);
      padding: 10px 20px;
      border-radius: 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      transition: all 0.2s;
    }

    .play-scream-btn:hover {
      background: var(--gold);
      color: #000;
    }

    /* Product Details */
    .hero-info .rating {
      color: var(--gold-light);
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 12px;
    }

    .hero-info h1 {
      font-size: 2.7rem;
      line-height: 1.15;
      margin-bottom: 16px;
      color: #fff;
    }

    .price-box {
      display: flex;
      align-items: baseline;
      gap: 14px;
      margin-bottom: 24px;
    }

    .current-price {
      font-size: 2.2rem;
      font-weight: 800;
      color: #ef4444;
    }

    .old-price {
      font-size: 1.25rem;
      text-decoration: line-through;
      color: var(--text-muted);
    }

    .discount-tag {
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 700;
    }

    .hero-desc {
      color: var(--text-muted);
      margin-bottom: 24px;
      font-size: 1.05rem;
    }

    /* Variants */
    .variant-section {
      margin-bottom: 28px;
    }

    .variant-label {
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 10px;
      display: block;
      color: var(--text-muted);
    }

    .variant-options {
      display: flex;
      gap: 12px;
    }

    .variant-btn {
      flex: 1;
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg-surface);
      color: var(--text-main);
      cursor: pointer;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .variant-btn.active {
      border-color: var(--gold-light);
      background: #25201c;
      color: var(--gold-light);
    }

    .swatch {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      display: inline-block;
    }

    .swatch-bone { background: #e5e5d8; }
    .swatch-obsidian { background: #1c1c1e; border: 1px solid #444; }
    .swatch-blood { background: #7f1d1d; }

    /* Features Grid */
    .specs-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin: 40px 0;
    }

    .spec-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      padding: 24px 20px;
      border-radius: var(--radius);
      text-align: center;
    }

    .spec-card .icon {
      font-size: 2rem;
      margin-bottom: 10px;
      display: block;
    }

    .spec-card h4 {
      font-size: 1.1rem;
      margin-bottom: 6px;
    }

    .spec-card p {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    /* Checkout Section */
    .checkout-section {
      padding: 80px 0;
      border-top: 1px solid var(--border);
    }

    .checkout-title {
      text-align: center;
      margin-bottom: 40px;
    }

    .checkout-grid {
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 40px;
      align-items: start;
    }

    .checkout-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 32px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 8px;
      color: var(--text-muted);
    }

    .form-control {
      width: 100%;
      padding: 12px 16px;
      border-radius: 8px;
      background: #0d0c0b;
      border: 1px solid var(--border);
      color: white;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.2s;
    }

    .form-control:focus {
      border-color: var(--gold-light);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .order-summary-item {
      display: flex;
      justify-content: space-between;
      margin-bottom: 12px;
      font-size: 0.95rem;
      color: var(--text-muted);
    }

    .order-summary-total {
      display: flex;
      justify-content: space-between;
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
      font-size: 1.25rem;
      font-weight: 700;
      color: #fff;
    }

    .btn-submit {
      width: 100%;
      background: linear-gradient(180deg, #ef4444 0%, #b91c1c 100%);
      color: white;
      border: none;
      padding: 16px;
      border-radius: 8px;
      font-size: 1.1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 24px;
      letter-spacing: 0.05em;
      transition: all 0.2s ease;
      box-shadow: 0 4px 20px rgba(220, 38, 38, 0.4);
    }

    .btn-submit:hover {
      opacity: 0.95;
      transform: translateY(-1px);
    }

    /* Modal / Alert */
    .success-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.85);
      z-index: 1000;
      justify-content: center;
      align-items: center;
    }

    .success-box {
      background: var(--bg-surface);
      border: 1px solid var(--gold);
      padding: 40px;
      border-radius: var(--radius);
      max-width: 450px;
      text-align: center;
    }

    @media (max-width: 900px) {
      .hero, .checkout-grid {
        grid-template-columns: 1fr;
      }
      .specs-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

  <!-- Top Announcement Bar -->
