        <!-- Summary -->
        <div class="checkout-card">
          <h3 style="margin-bottom: 20px; font-size: 1.25rem;">Order Summary</h3>
          <div style="display: flex; gap: 14px; margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--border);">
            <img src="https://img.kwcdn.com/product/fancy/1aca0b30-cde6-4da1-ac6c-f72760ec78dd.jpg" style="width: 70px; height: 70px; border-radius: 8px; object-fit: cover; border: 1px solid var(--border);" alt="Cart Thumbnail">
            <div>
              <div style="font-weight: 700;">Aztec Screaming Death Whistle</div>
              <div style="font-size: 0.85rem; color: var(--gold-light);" id="summaryVariant">Variant: Ancient Bone</div>
              <div style="font-size: 0.85rem; color: var(--text-muted);">Qty: 1</div>
            </div>
          </div>

          <div class="order-summary-item">
            <span>Retail Price</span>
            <span>$49.99</span>
          </div>
          <div class="order-summary-item" style="color: #4ade80;">
